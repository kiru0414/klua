# EmbedLua.cmake -- bake a Lua source file into a C++ header as a raw string
# literal. Invoked at build time via `cmake -DINPUT=... -DOUTPUT=... -P`.
#
# The generated header exposes:
#   namespace klua::assets { inline constexpr const char* default_init_lua; }

if(NOT DEFINED INPUT OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "EmbedLua.cmake requires -DINPUT=<lua file> and -DOUTPUT=<header file>")
endif()

file(READ "${INPUT}" KLUA_LUA_SOURCE)

# The raw string delimiter must never appear inside the embedded source.
string(FIND "${KLUA_LUA_SOURCE}" ")KLUA\"" KLUA_DELIM_POS)
if(NOT KLUA_DELIM_POS EQUAL -1)
    message(FATAL_ERROR "${INPUT} contains the raw string delimiter ')KLUA\"'; cannot embed it safely.")
endif()

get_filename_component(KLUA_OUT_DIR "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${KLUA_OUT_DIR}")

file(WRITE "${OUTPUT}"
"// Generated by cmake/EmbedLua.cmake from builtin/default_init.lua -- do not edit.
#pragma once

namespace klua::assets {

// Built-in Lua baseline used for self-healing and `klua repair`.
inline constexpr const char* default_init_lua = R\"KLUA(${KLUA_LUA_SOURCE})KLUA\";

} // namespace klua::assets
")
